{
  "name": "expo-agent-cli-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/@expo/*",
    "apps/*",
    "packages/@expo/agent-cli/evals/fixtures/real-app"
  ],
  "scripts": {
    "bundle": "bun run --filter expo-agent-cli bundle",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test scripts packages/expo-agent-cli && bun run --filter @expo/agent-cli test"
  },
  "devDependencies": {
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0"
  }
}
