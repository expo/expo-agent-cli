{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "harness/**/*.ts",
    "tier1/**/*.ts",
    "smoke/**/*.ts",
    "vitest.config.ts",
    "tier2/*.mjs",
    "tier2/*.mts",
    "tier2/*.eval.ts"
  ]
}
