#!/usr/bin/env node
// Stub `@expo/fingerprint` bin. It stands in for the real CLI, so the e2e tests can exercise the
// "fingerprint matches the last build" branch of the decision table without hashing anything.
//
// The probe spawns `fingerprint fingerprint:generate <projectRoot>` and reads the last JSON line
// of stdout, so this prints one JSON object with a `hash` field.
//
// **It records every invocation**, one JSON line per run, the way the stub `expo` bin does. That
// log is how the caching tests measure what they are about: a memo that works and a cache that
// revalidates are both invisible in the output and are exactly a number of subprocesses
// (llp/0023 §Proof).
//
// Behavior is controlled through environment variables set by the test:
// - STUB_FINGERPRINT_HASH: hash to print (default `FIXTURE_HASH` below), to simulate a change
// - STUB_FINGERPRINT_HASH_FROM_PROJECT: `1` to derive the hash from the app config, eas.json and
//   package.json instead, and to emit one source per file and per dependency with the reasons the
//   real sourcer uses — so a test that edits those files moves the fingerprint the way a real
//   hasher would, and the plan engine's classifier sees what moved. That is what lets an e2e watch
//   "the app config changed, so the plan prebuilds" next to "only eas.json changed, so it does not"
// - STUB_FINGERPRINT_EXIT_CODE: exit code to return (default 0), to test the failure path
// - STUB_FINGERPRINT_LOG: file the invocation is appended to
//   (default `<cwd>/stub-fingerprint-invocations.jsonl`)
'use strict';

const fs = require('node:fs');
const path = require('node:path');

// Kept in sync by hand with `.expo/agent-cli-last-build.json` in this fixture: the recorded build
// matches this hash, which is what makes the fixture "fresh".
const FIXTURE_HASH = '0f1e2d3c4b5a69788796a5b4c3d2e1f001234567';

const args = process.argv.slice(2);
const cwd = process.cwd();
const logPath =
  process.env.STUB_FINGERPRINT_LOG || path.join(cwd, 'stub-fingerprint-invocations.jsonl');

// Appended before anything else, so a run that then fails is still counted: the tests care how
// many subprocesses happened, and a failed one happened.
try {
  fs.appendFileSync(logPath, JSON.stringify({ args, cwd }) + '\n');
} catch {
  // A log that cannot be written costs the assertion, not the run under test.
}

const exitCode = Number(process.env.STUB_FINGERPRINT_EXIT_CODE || 0);
if (exitCode !== 0) {
  process.stderr.write('stub fingerprint failed\n');
  process.exit(exitCode);
}

let hash = process.env.STUB_FINGERPRINT_HASH || FIXTURE_HASH;
let sources = [];
if (process.env.STUB_FINGERPRINT_HASH_FROM_PROJECT === '1') {
  // The same files the real hasher reads first. Missing ones are skipped, so the stub works in
  // any fixture shape.
  const crypto = require('node:crypto');
  const projectRoot = args[1] && !args[1].startsWith('-') ? args[1] : cwd;
  const sha1 = (data) => crypto.createHash('sha1').update(data).digest('hex');
  const digest = crypto.createHash('sha1');

  // One source per file, with the reason the real sourcer gives it, so the plan engine's
  // classifier sees the same shapes it sees live. Without these the e2e tests of "what changed
  // decides the plan" pass through the conservative empty-diff fallback instead of the classifier,
  // and a broken classifier goes unnoticed. Reasons transcribed from `src/impact/classify.ts`
  // REASON_KINDS: `expoConfig` for the app config, `easBuild` for eas.json.
  const FILE_SOURCES = [
    ['app.json', 'expoConfig'],
    ['app.config.js', 'expoConfig'],
    ['eas.json', 'easBuild'],
  ];
  for (const [name, reason] of FILE_SOURCES) {
    try {
      const contents = fs.readFileSync(path.join(projectRoot, name));
      digest.update(contents);
      sources.push({ type: 'file', filePath: name, reasons: [reason], hash: sha1(contents) });
    } catch {}
  }

  // Dependencies as the autolinking sources the real fingerprint emits per native module: one
  // source per name, hashed on the declared version, so adding or bumping a dependency reads as an
  // autolinked-surface change (`expoAutolinkingIos` -> native-module -> prebuild + build).
  try {
    const packageJson = fs.readFileSync(path.join(projectRoot, 'package.json'));
    digest.update(packageJson);
    const dependencies = JSON.parse(packageJson).dependencies || {};
    for (const [name, version] of Object.entries(dependencies)) {
      sources.push({
        type: 'dir',
        filePath: `node_modules/${name}`,
        reasons: ['expoAutolinkingIos'],
        hash: sha1(String(version)),
      });
    }
  } catch {}

  hash = digest.digest('hex');
}
process.stdout.write(JSON.stringify({ hash, sources }) + '\n');
